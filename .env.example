# Copy to .env and fill in. Empty optional keys turn that feature off.

# --- Database (PostgreSQL, e.g. Neon) ---
DATABASE_URL=

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Safepay, optional; without keys plans switch for free) ---
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_ENV=sandbox
# SAFEPAY_WEBHOOK_SECRET=
# SAFEPAY_API_URL=

# --- TMDB: titles, posters, cast, episodes ---
# themoviedb.org -> Settings -> API. Use the "API Read Access Token" (v4, preferred)
# or the v3 "API Key". One of the two is enough.
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Region for "now playing" and age ratings, and the language of titles/overviews.
TMDB_REGION=IN
TMDB_LANGUAGE=en-US

# --- Movie of the Night (Streaming Availability API): audio + subtitle languages ---
# RapidAPI: subscribe to "Streaming Availability" and use these defaults.
# Movie of the Night developer platform: MOTN_API_BASE=https://api.movieofthenight.com/v4
# (MOTN_API_HOST is then ignored).
MOTN_API_KEY=
MOTN_API_BASE=https://streaming-availability.p.rapidapi.com
MOTN_API_HOST=streaming-availability.p.rapidapi.com
# Country whose streaming options are read (Pakistan is not supported; India is closest).
MOTN_COUNTRY=in
